<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;CS1591;IL2026;IL3050</NoWarn>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <RootNamespace>Plugin.Maui.LocalStore</RootNamespace>
    <AssemblyName>Plugin.Maui.LocalStore</AssemblyName>
    <PackageId>Plugin.Maui.LocalStore</PackageId>
    <Title>.NET MAUI LocalStore — Room-style local database facade</Title>
    <Description>Room-style app-document facade for .NET MAUI. One collection API; the host picks SQLite, NuvexaDB, Realm, LiteDB, DuckDB, SQLCipher, Firebird, LMDB, RocksDB, or LevelDB. Auto-migrate between engines. Source-generated DAOs and raw SQL/NQL on ILocalStore. Not a job queue or OfflineSync.</Description>
    <PackageTags>dotnet-maui;maui;maui-plugin;sqlite;nuvexadb;realm;litedb;duckdb;sqlcipher;firebird;lmdb;rocksdb;leveldb;local-store;room;embedded;offline;android;ios;maccatalyst;windows;mauiessentials</PackageTags>
    <Authors>Niladri</Authors>
    <Company>MauiEssentials</Company>
    <Copyright>Copyright © 2026 Niladri</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://nuvyntralabs.github.io/packages/plugin-maui-local-store/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nuvyntralabs/Plugin.Maui.LocalStore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.1.0</Version>
    <PackageVersion>1.1.0</PackageVersion>
    <PackageReleaseNotes>1.1.0: Automatic engine migration (AutoMigrate + Map&lt;T&gt;). Raw SQL/NQL on ILocalStore. Source-generated [StoreDao] implementations.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\nuget.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite -->
    <PackageReference Include="sqlite-net-base" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- SQLCipher (encrypted SQLite). Do not also reference sqlite-net-sqlcipher — it duplicates sqlite-net-base types. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="Nuventra.NuvexaDB" Version="1.0.5" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Realm" Version="20.1.0" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.5" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
    <PackageReference Include="FirebirdDb.Embedded.V5.NativeAssets.Windows.All" Version="2.0.6" />
    <PackageReference Include="FirebirdDb.Embedded.V5.NativeAssets.Linux.All" Version="2.0.6" />
    <!-- No maccatalyst RID; the iOS dylib is linked into Catalyst and fails. JSON fallback instead. -->
    <PackageReference Include="LightningDB" Version="0.23.0" />
    <PackageReference Update="LightningDB"
                      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'"
                      ExcludeAssets="native;build;buildTransitive" />
    <PackageReference Include="RocksDB" Version="11.8.1.5032" />
    <!-- Native leveldb.dll files are ELF/Mach-O; Android ProcessAssemblies treats them as PE and fails. -->
    <PackageReference Include="LevelDB.Standard" Version="2.1.6.1" ExcludeAssets="native;build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plugin.Maui.LocalStore.SourceGenerators\Plugin.Maui.LocalStore.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Plugin.Maui.LocalStore.SourceGenerators\bin\$(Configuration)\netstandard2.0\Plugin.Maui.LocalStore.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plugin.Maui.LocalStore.Tests" />
  </ItemGroup>

</Project>
